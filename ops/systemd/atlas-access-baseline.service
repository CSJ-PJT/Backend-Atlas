[Unit]
Description=Finalize the pre-monitoring Atlas access identity baseline
After=nginx.service

[Service]
Type=oneshot
User=root
Group=root
Environment=ATLAS_ACCESS_START_DATE=2026-08-26
StateDirectory=atlas-access-monitor
StateDirectoryMode=0700
RuntimeDirectory=atlas-access-monitor
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/atlas-access-monitor/run.lock /usr/bin/node /usr/local/libexec/atlas-access-monitor.mjs baseline
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadOnlyPaths=/var/log/nginx
ReadWritePaths=/var/lib/atlas-access-monitor /run/atlas-access-monitor

[Install]
WantedBy=multi-user.target
